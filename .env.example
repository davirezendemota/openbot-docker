# Primary stack (compose.yaml) — copy to .env and fill secrets.

COMPOSE_PROJECT_NAME=openbot-docker

# Pin upstream OpenBot (tag + digest). Verify with gh attestation when upgrading.
OPENBOT_IMAGE=ghcr.io/nightly-labs/openbot:0.57.0@sha256:84aadc0ce11beeadabfa1f17e4cc4d56bc27ed45f3ff9f3dbf7a6b3fe03471ef
OPENBOT_TAILSCALE_IMAGE=tailscale/tailscale:stable@sha256:ed6480b33c6eb67c9cbd203ed42b9fb57e361986725b6856def71b7a3d9e276c

# Tailscale: reusable auth key with a tag that matches your ACL (e.g. tag:openbot).
OPENBOT_TAILSCALE_AUTHKEY=
TS_HOSTNAME=openbot-node-1

# Docker bridge name must match compose network driver_opts and host/firewall.conf
OPENBOT_BRIDGE_NAME=br-openbot-1

OPENBOT_MEM_LIMIT=6g
OPENBOT_CPUS=4
